{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./",              // project root
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
     "resolveJsonModule": true,
    
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "pageobject ts/**/*.ts"],
  "exclude": ["node_modules", "**/*.js"]
}
